# --- Database (Postgres on Hostinger) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set to "true" if the Postgres host requires SSL (most Hostinger managed DBs do)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Admin ---
# Signs the admin session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://atcajmer.com
