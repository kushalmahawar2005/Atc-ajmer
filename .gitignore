# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
.env.local
.env*.local

# pm2 / deploy
logs/
.deploy/
tsconfig.tsbuildinfo

# Large downloadable PDFs — synced to the server, not tracked in git
public/download/
!public/download/
public/download/*
!public/download/ras-exam-scheme.pdf
!public/download/ras-pre-syllabus-hindi.pdf
!public/download/ras-pre-syllabus-english.pdf
!public/download/ras-mains-syllabus-hindi.pdf
!public/download/ras-mains-syllabus-english.pdf
!public/download/upsc-syllabus.pdf
!public/download/upsc-syllabus-hindi.pdf
!public/download/psi-physical.pdf
!public/download/psi-paper-1.pdf
!public/download/psi-paper-2.pdf
